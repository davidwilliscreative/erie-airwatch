# Website (web/.env.local). Leave both empty to run the synthetic demo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# AIRWATCH_DEMO_ADMIN=1          # show the browser-only demo admin in a production build

# Worker (server-side secrets only; never put these in the website)
DATABASE_URL=
# AIRWATCH_PROVIDER_API_KEY=
# AIRWATCH_PROVIDER_LICENSE_REF=      # only after a licence is signed
# AIRWATCH_ENABLE_LICENSED_PROVIDER=  # set to "yes" deliberately, after the above
